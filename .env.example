# Copy to .env for Docker Compose. Keep the default listener bound to this machine only.
VERITY_BIND=127.0.0.1

# Optional: for a remote/shared deployment, set unique long random bearer tokens
# in owner=token,owner2=token format, then use HTTPS at a trusted reverse proxy.
APP_API_TOKENS=

# Optional Fernet key for encrypted provider-key persistence. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Optional environment-based provider credentials. The local mode needs none.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_AI_API_KEY=

# Optional limits/configuration. Defaults are conservative for a local workstation.
# MAX_INPUT_CHARS=200000
# MAX_UPLOAD_BYTES=10485760
# MAX_TOTAL_UPLOAD_BYTES=26214400
# MAX_SOURCE_BYTES=5242880
# MAX_CLAIMS=120
